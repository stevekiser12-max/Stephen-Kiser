# Copy to ".env" and fill in. Never commit the real .env.
# (Load it with your process manager, or `node --env-file=.env server/index.js` on Node 20+.)

# Port the server listens on.
PORT=3000

# Bearer token that protects the /admin dashboard and /api/attempts admin routes.
# Generate a strong one, e.g.:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=change-me-to-a-long-random-string

# Where the SQLite file lives. Defaults to ./data/assessment.db if unset.
# DB_PATH=/var/data/assessment.db
